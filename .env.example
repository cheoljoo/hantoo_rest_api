# 한국투자증권 Open API 인증 정보
# 실전투자 앱키/시크릿은 https://apiportal.koreainvestment.com 에서 발급받는다.
KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호 10자리 중 앞 8자리(계좌번호) + 뒤 2자리(상품코드)
# 예) 계좌번호가 12345678-01 이라면 아래처럼 나눠서 입력
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CD=01

# 모의투자 여부 (true: 모의투자, false: 실전투자)
KIS_IS_VIRTUAL=false

# 대시보드에 표시할 이름 (생략하면 계좌번호를 그대로 표시)
KIS_ACCOUNT_LABEL=주 계좌

# --- 계좌를 여러 개 쓰는 경우 (선택) ---
# 한투 Open API는 신청 시 계좌 1개를 선택해 인증하는 방식이라, 계좌마다
# 앱을 별도로 등록해서 앱키/시크릿을 따로 받아야 한다. 두 번째 계좌부터는
# 아래처럼 _2, _3, _4 ... 번호를 붙여서 추가하면 웹 대시보드에 탭으로 함께
# 표시된다 (계좌 수 제한 없음, 번호가 중간에 비면 그 지점에서 인식을 멈춘다).
# KIS_APP_KEY_2=
# KIS_APP_SECRET_2=
# KIS_ACCOUNT_NO_2=
# KIS_ACCOUNT_PRODUCT_CD_2=01
# KIS_IS_VIRTUAL_2=false
# KIS_ACCOUNT_LABEL_2=퇴직연금 계좌
#
# KIS_APP_KEY_3=
# KIS_APP_SECRET_3=
# KIS_ACCOUNT_NO_3=
# KIS_ACCOUNT_PRODUCT_CD_3=01
# KIS_IS_VIRTUAL_3=false
# KIS_ACCOUNT_LABEL_3=ISA 계좌
